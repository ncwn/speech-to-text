# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Model weights and caches — never commit, these are 1-31 GB each
models/
*.pt
*.gguf
*.safetensors
*.mlmodelc/

# Dataset audio stays local; references, transcripts, and provenance are tracked.
data/*/audio/**
# Keep audio from older checkouts ignored after the layout migration.
data/audio/**
data/fleurs*/
# Resampled 16 kHz mono copies produced by stt.audio, and ad-hoc slices
data/.converted/
data/.slices/
outputs/**
!outputs/.gitkeep

# Third-party sources built from scratch
vendor/

# Local credentials
.env
*.json.key
service-account*.json

# macOS
.DS_Store
