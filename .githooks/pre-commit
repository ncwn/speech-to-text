#!/usr/bin/env bash

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

scripts/check_branch_name.sh

if ! command -v uv >/dev/null; then
    printf 'pre-commit: uv is required\n' >&2
    exit 1
fi

printf 'pre-commit: running offline checks\n'
if ! make check >/tmp/stt-precommit.log 2>&1; then
    printf 'pre-commit failed; commit aborted\n\n' >&2
    tail -30 /tmp/stt-precommit.log >&2
    printf '\nFull log: /tmp/stt-precommit.log\n' >&2
    exit 1
fi
printf 'pre-commit: checks passed\n'
