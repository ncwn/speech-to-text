# Copy to .env and fill in. .env is gitignored.
# Only needed for the cloud backends, which are not implemented yet.

# ElevenLabs Scribe v2
# ELEVENLABS_API_KEY=

# Google Cloud Speech-to-Text (Chirp 3)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Where model weights are cached. Defaults to <checkout>/.cache, which keeps a
# clone self-contained. Set to ~/.cache for the conventional per-user location.
# STT_CACHE_DIR=

# HF_HOME is derived from STT_CACHE_DIR unless you set it explicitly.
# HF_HOME=
